# Avoid git_describe failure in PlatformIO builds
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.0"

# Console on USB-Serial-JTAG (XIAO ESP32-S3 has no USB-UART bridge)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Flash: 8MB
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Partition table: custom OTA-capable layout
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# WiFi
CONFIG_ESP_WIFI_ENABLED=y

# BLE: NimBLE, observer + broadcaster (broadcaster needed for link-time)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y

# BLE + WiFi coexistence on single antenna
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# HTTP server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# FreeRTOS timer task needs enough stack for esp_wifi_connect() in reconnect callback
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# lwIP: more sockets for HTTP + DNS + MQTT + BLE coexistence
CONFIG_LWIP_MAX_SOCKETS=16

# Disable WiFi power save for reliable BLE scanning
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
