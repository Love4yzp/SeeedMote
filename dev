#!/usr/bin/env python3
"""Human-friendly development entrypoint for SeeedMote v2."""

from __future__ import annotations

import argparse
from collections import deque
import glob
import os
import signal
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path


ROOT = Path(__file__).resolve().parent
MOTE_DIR = ROOT / "mote"
GATEWAY_YAML = ROOT / "gateway" / "esphome.yaml"
DEFAULT_NCS = "v2.9.2"
DEFAULT_BOARD = "xiao_ble/nrf52840/sense"
DEFAULT_BUILD_DIR = "build_uf2"
DEFAULT_VOLUME = "/Volumes/XIAO-SENSE"
DEFAULT_PORT_GLOB = "/dev/cu.usbmodem*"
ROOT_COMMANDS = ("mote", "gateway", "app", "doctor", "help")
COMMAND_GROUPS = ("mote", "gateway", "app")


class DevArgumentParser(argparse.ArgumentParser):
    def __init__(self, *args: object, **kwargs: object) -> None:
        kwargs.setdefault("formatter_class", argparse.RawDescriptionHelpFormatter)
        super().__init__(*args, **kwargs)


class ParserRegistry:
    def __init__(self) -> None:
        self.parsers: dict[tuple[str, ...], argparse.ArgumentParser] = {}

    def add(self, topic: tuple[str, ...], parser: argparse.ArgumentParser) -> argparse.ArgumentParser:
        self.parsers[topic] = parser
        return parser

    def get(self, topic: list[str]) -> argparse.ArgumentParser | None:
        return self.parsers.get(tuple(topic))


def rel(path: Path | str) -> str:
    path = Path(path)
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


def shell_line(command: list[str], env: dict[str, str] | None = None) -> str:
    prefix = ""
    if env:
        prefix = " ".join(f"{key}={shlex.quote(value)}" for key, value in env.items()) + " "
    return prefix + shlex.join(command)


def run_command(
    command: list[str],
    *,
    cwd: Path = ROOT,
    env: dict[str, str] | None = None,
    dry_run: bool = False,
) -> None:
    if dry_run:
        print(f"cwd: {rel(cwd)}")
        print(f"$ {shell_line(command, env)}")
        return

    ensure_tool(command[0])

    merged_env = os.environ.copy()
    if env:
        merged_env.update(env)
    subprocess.run(command, cwd=cwd, env=merged_env, check=True)


def run_command_for_gateway(command: list[str], *, cwd: Path = ROOT, env: dict[str, str] | None = None) -> None:
    ensure_tool(command[0])

    merged_env = os.environ.copy()
    if env:
        merged_env.update(env)

    proc = subprocess.Popen(
        command,
        cwd=cwd,
        env=merged_env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        bufsize=1,
    )
    tail: deque[str] = deque(maxlen=200)

    try:
        assert proc.stdout is not None
        for line in proc.stdout:
            print(line, end="")
            tail.append(line)
        returncode = proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
        raise SystemExit(130)

    if returncode != 0:
        output = "".join(tail)
        raise subprocess.CalledProcessError(returncode, command, output, "")


def terminate_process_group(proc: subprocess.Popen[object], timeout: float = 5.0) -> None:
    if proc.poll() is not None:
        return

    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except OSError:
        return

    try:
        proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        if proc.poll() is not None:
            return
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            return
        try:
            proc.wait(timeout=1.0)
        except subprocess.TimeoutExpired:
            return


def run_command_for_app(command: list[str], *, cwd: Path = ROOT, env: dict[str, str] | None = None) -> None:
    ensure_tool(command[0])

    merged_env = os.environ.copy()
    if env:
        merged_env.update(env)

    proc = subprocess.Popen(command, cwd=cwd, env=merged_env, start_new_session=True)
    signals = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
    previous_handlers = {sig: signal.getsignal(sig) for sig in signals}

    def handle_stop(signum: int, _frame: object) -> None:
        terminate_process_group(proc)
        raise SystemExit(128 + signum)

    for sig in signals:
        signal.signal(sig, handle_stop)

    try:
        returncode = proc.wait()
    finally:
        for sig, handler in previous_handlers.items():
            signal.signal(sig, handler)

    if returncode != 0:
        raise subprocess.CalledProcessError(returncode, command)


def ensure_tool(tool: str) -> None:
    if shutil.which(tool) is not None:
        return
    hints = {
        "nrfutil": "Install nrfutil and NCS toolchain-manager; see docs/build.md.",
        "tio": "Install tio, or pass a tool-specific log command outside ./dev.",
        "esphome": "Install ESPHome CLI with pip install esphome.",
        "make": "Install Xcode command line tools so make is available.",
    }
    hint = hints.get(tool, f"Install {tool} or add it to PATH.")
    raise SystemExit(f"Missing required tool: {tool}\n{hint}")


def is_esptoolpy_corruption_error(error_text: str | None) -> bool:
    if not error_text:
        return False
    return (
        "tool-esptoolpy" in error_text
        and "does not appear to be a Python project" in error_text
    )


def repair_esptoolpy_if_needed(error: subprocess.CalledProcessError) -> bool:
    stderr = error.stderr or ""
    stdout = error.stdout or ""
    combined = f"{stdout}\n{stderr}"
    if not is_esptoolpy_corruption_error(combined):
        return False

    print(
        "PlatformIO reported the pioarduino tool-esptoolpy package warning, "
        "but deleting that package does not fix this platform release; not retrying."
    )
    return False


def ncs_env(ncs_version: str) -> dict[str, str]:
    return {"ZEPHYR_BASE": str(Path.home() / "ncs" / ncs_version / "zephyr")}


def west_command(ncs_version: str, west_args: list[str]) -> list[str]:
    return [
        "nrfutil",
        "toolchain-manager",
        "launch",
        "--ncs-version",
        ncs_version,
        "--",
        "west",
        *west_args,
    ]


def mote_build(args: argparse.Namespace) -> None:
    if getattr(args, "clean", False):
        mote_clean(args)

    command = west_command(
        args.ncs,
        [
            "build",
            "--no-sysbuild",
            "-p",
            "always",
            "-b",
            args.board,
            "-d",
            args.build_dir,
        ],
    )
    if args.debug:
        command.extend(["--", "-DEXTRA_CONF_FILE=debug.conf"])

    run_command(command, cwd=MOTE_DIR, env=ncs_env(args.ncs), dry_run=args.dry_run)


def mote_clean(args: argparse.Namespace) -> None:
    command = west_command(args.ncs, ["build", "-d", args.build_dir, "-t", "pristine"])
    run_command(command, cwd=MOTE_DIR, env=ncs_env(args.ncs), dry_run=args.dry_run)


def expanded_ports(port: str | None) -> list[str]:
    if port:
        return [port]
    return sorted(glob.glob(DEFAULT_PORT_GLOB))


def touch_1200_baud(ports: list[str]) -> None:
    if not ports:
        return
    import termios

    for port in ports:
        try:
            print(f"1200-baud touch -> {port}")
            fd = os.open(port, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
            try:
                attrs = termios.tcgetattr(fd)
                attrs[4] = termios.B1200
                attrs[5] = termios.B1200
                termios.tcsetattr(fd, termios.TCSANOW, attrs)
            finally:
                os.close(fd)
            time.sleep(0.05)
        except OSError as exc:
            print(f"  skip {port}: {exc}")


def wait_for_volume(volume: str, seconds: float) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if Path(volume).is_dir():
            return True
        time.sleep(0.3)
    return Path(volume).is_dir()


def wait_for_volume_gone(volume: str, seconds: float) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if not Path(volume).is_dir():
            return True
        time.sleep(0.3)
    return not Path(volume).is_dir()


def copy_uf2_to_volume(uf2: Path, volume: str) -> None:
    dest = Path(volume) / uf2.name
    last_error: OSError | None = None
    for attempt in (1, 2):
        try:
            shutil.copyfile(uf2, dest)
            return
        except PermissionError as exc:
            last_error = exc
            if attempt == 1:
                time.sleep(0.5)
                continue
            raise
    assert last_error is not None
    raise last_error


def mote_flash(args: argparse.Namespace) -> None:
    mote_build(args)

    uf2 = MOTE_DIR / args.build_dir / "zephyr" / "zephyr.uf2"
    ports = expanded_ports(args.port)

    if args.dry_run:
        for port in ports or [DEFAULT_PORT_GLOB]:
            print(f"1200-baud touch -> {port}")
        print(f"wait for volume: {args.volume}")
        print(f"$ python: shutil.copyfile({rel(uf2)!r}, {args.volume + '/' + uf2.name!r})")
        return

    touch_1200_baud(ports)
    print(f"Waiting for {args.volume} (up to 3s, auto via 1200-baud touch)...")
    mounted = wait_for_volume(args.volume, 3)
    if not mounted:
        print()
        print("XIAO bootloader volume was not found.")
        print("Double-tap RESET on the XIAO nRF52840 Sense now.")
        print(f"Waiting for {args.volume} (up to 30s)...")
        mounted = wait_for_volume(args.volume, 30)

    if not mounted:
        raise SystemExit(f"{args.volume} still not mounted; flash aborted.")
    if not uf2.exists():
        raise SystemExit(f"UF2 not found: {uf2}")

    uf2_size = uf2.stat().st_size
    copy_uf2_to_volume(uf2, args.volume)
    print(f"copied {uf2_size} bytes -> {args.volume}/{uf2.name}")

    print(f"Waiting for bootloader to accept firmware (volume {args.volume} should unmount)...")
    if wait_for_volume_gone(args.volume, 10):
        print("flash OK: bootloader processed UF2 and rebooted.")
    else:
        print(f"WARN: {args.volume} still mounted after 10s; firmware may not have been accepted.")


def resolve_log_port(port: str | None) -> str:
    ports = expanded_ports(port)
    if not ports:
        raise SystemExit(f"No serial port matched {DEFAULT_PORT_GLOB}; pass --port /dev/cu.*")
    if len(ports) > 1 and port is None:
        print(f"Multiple ports found; using {ports[0]}. Pass --port to choose explicitly.")
    return ports[0]


def mote_log(args: argparse.Namespace) -> None:
    port = args.port or DEFAULT_PORT_GLOB
    if not args.dry_run:
        port = resolve_log_port(args.port)
    run_command(["tio", port], dry_run=args.dry_run)


def mote_run(args: argparse.Namespace) -> None:
    mote_flash(args)
    mote_log(args)


def gateway_command(args: argparse.Namespace, action: str) -> None:
    command = ["esphome", action, rel(GATEWAY_YAML)]
    if args.dry_run:
        run_command(command, dry_run=True)
        return

    try:
        run_command_for_gateway(command, cwd=ROOT)
    except subprocess.CalledProcessError as exc:
        if repair_esptoolpy_if_needed(exc):
            run_command_for_gateway(command, cwd=ROOT)
            return
        raise


def app_command(args: argparse.Namespace, target: str) -> None:
    command = ["make", "-C", "app", target]
    if target == "dev":
        command.append(f"MOCK={'true' if args.mock else 'false'}")
        command.append(f"BACKEND_PORT={args.backend_port}")
        command.append(f"FRONTEND_PORT={args.frontend_port}")
    if args.dry_run:
        run_command(command, dry_run=True)
        return
    run_command_for_app(command)


def doctor(args: argparse.Namespace) -> None:
    if args.dry_run:
        print("doctor checks skipped in --dry-run")
        return

    checks = [
        ("nrfutil", shutil.which("nrfutil") is not None),
        ("tio", shutil.which("tio") is not None),
        ("esphome", shutil.which("esphome") is not None),
        ("gateway/secrets.yaml", (ROOT / "gateway" / "secrets.yaml").exists()),
        (f"~/ncs/{args.ncs}/zephyr", (Path.home() / "ncs" / args.ncs / "zephyr").exists()),
        (DEFAULT_VOLUME, Path(DEFAULT_VOLUME).is_dir()),
    ]

    for name, ok in checks:
        print(f"{'ok' if ok else 'missing'}  {name}")

    ports = sorted(glob.glob("/dev/cu.*"))
    if ports:
        print("serial ports:")
        for port in ports:
            print(f"  {port}")
    else:
        print("serial ports: none")


def add_mote_options(parser: argparse.ArgumentParser, *, include_debug: bool = False) -> None:
    parser.add_argument("--ncs", default=DEFAULT_NCS, help=f"NCS version, default: {DEFAULT_NCS}")
    parser.add_argument("--board", default=DEFAULT_BOARD, help=f"Zephyr board, default: {DEFAULT_BOARD}")
    parser.add_argument("--build-dir", default=DEFAULT_BUILD_DIR, help=f"Build directory, default: {DEFAULT_BUILD_DIR}")
    if include_debug:
        parser.add_argument("--debug", action="store_true", help="Build with mote/debug.conf USB CDC console")


def add_dry_run_option(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--dry-run", action="store_true", help="Print commands without running them")


def build_parser() -> tuple[argparse.ArgumentParser, ParserRegistry]:
    registry = ParserRegistry()
    parser = registry.add(
        (),
        DevArgumentParser(
            prog="./dev",
            description="SeeedMote v2 development CLI",
            epilog="""examples:
  ./dev doctor
  ./dev mote build
  ./dev mote flash --debug
  ./dev gateway run
  ./dev app run --mock
  ./dev help mote build
""",
        ),
    )
    parser.add_argument("--dry-run", action="store_true", help="Print commands without running them")

    subparsers = parser.add_subparsers(dest="area", required=True)

    mote = registry.add(
        ("mote",),
        subparsers.add_parser(
            "mote",
            help="nRF52840 mote firmware",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""examples:
  ./dev mote build
  ./dev mote build --debug
  ./dev mote flash --volume /Volumes/XIAO-SENSE
  ./dev mote log --port /dev/cu.usbmodem101
  ./dev mote run --debug
""",
        ),
    )
    add_dry_run_option(mote)
    mote_sub = mote.add_subparsers(dest="action", required=True)

    mote_build_parser = registry.add(
        ("mote", "build"),
        mote_sub.add_parser(
            "build",
            help="Build mote UF2 firmware",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""examples:
  ./dev mote build
  ./dev mote build --debug
  ./dev mote build --clean
  ./dev mote build --dry-run
""",
        ),
    )
    add_dry_run_option(mote_build_parser)
    add_mote_options(mote_build_parser, include_debug=True)
    mote_build_parser.add_argument("--clean", action="store_true", help="Pristine before building")
    mote_build_parser.set_defaults(func=mote_build)

    mote_flash_parser = registry.add(
        ("mote", "flash"),
        mote_sub.add_parser(
            "flash",
            help="Build and copy UF2 to the XIAO bootloader volume",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""examples:
  ./dev mote flash
  ./dev mote flash --debug
  ./dev mote flash --volume /Volumes/XIAO-SENSE
""",
        ),
    )
    add_dry_run_option(mote_flash_parser)
    add_mote_options(mote_flash_parser, include_debug=True)
    mote_flash_parser.add_argument("--volume", default=DEFAULT_VOLUME, help=f"UF2 volume, default: {DEFAULT_VOLUME}")
    mote_flash_parser.add_argument("--port", help="Serial port used for 1200-baud bootloader touch")
    mote_flash_parser.set_defaults(func=mote_flash)

    mote_log_parser = registry.add(("mote", "log"), mote_sub.add_parser("log", help="Open mote serial logs"))
    add_dry_run_option(mote_log_parser)
    mote_log_parser.add_argument("--port", help=f"Serial port, default: {DEFAULT_PORT_GLOB}")
    mote_log_parser.set_defaults(func=mote_log)

    mote_run_parser = registry.add(
        ("mote", "run"),
        mote_sub.add_parser(
            "run",
            help="Flash mote firmware, then open logs",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""examples:
  ./dev mote run
  ./dev mote run --debug
  ./dev mote run --port /dev/cu.usbmodem101
""",
        ),
    )
    add_dry_run_option(mote_run_parser)
    add_mote_options(mote_run_parser, include_debug=True)
    mote_run_parser.add_argument("--volume", default=DEFAULT_VOLUME, help=f"UF2 volume, default: {DEFAULT_VOLUME}")
    mote_run_parser.add_argument("--port", help="Serial port")
    mote_run_parser.set_defaults(func=mote_run)

    mote_clean_parser = registry.add(("mote", "clean"), mote_sub.add_parser("clean", help="Pristine mote build directory"))
    add_dry_run_option(mote_clean_parser)
    add_mote_options(mote_clean_parser)
    mote_clean_parser.set_defaults(func=mote_clean)

    gateway = registry.add(
        ("gateway",),
        subparsers.add_parser(
            "gateway",
            help="ESPHome gateway",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""examples:
  ./dev gateway compile
  ./dev gateway run
  ./dev gateway log
""",
        ),
    )
    add_dry_run_option(gateway)
    gateway_sub = gateway.add_subparsers(dest="action", required=True)
    for name, action, help_text in (
        ("compile", "compile", "Compile gateway ESPHome config"),
        ("run", "run", "Compile, flash, and stream gateway log output"),
        ("log", "logs", "Stream gateway log output"),
    ):
        gateway_parser = registry.add(("gateway", name), gateway_sub.add_parser(name, help=help_text))
        add_dry_run_option(gateway_parser)
        gateway_parser.set_defaults(func=lambda args, esphome_action=action: gateway_command(args, esphome_action))

    app = registry.add(
        ("app",),
        subparsers.add_parser(
            "app",
            help="Retail demo app",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""examples:
  ./dev app run
  ./dev app run --mock
""",
        ),
    )
    add_dry_run_option(app)
    app_sub = app.add_subparsers(dest="action", required=True)
    app_run_parser = registry.add(("app", "run"), app_sub.add_parser("run", help="Start backend and frontend"))
    add_dry_run_option(app_run_parser)
    app_run_parser.add_argument("--mock", action="store_true", help="Use scripted mock events")
    app_run_parser.add_argument("--backend-port", default="3001", help="Backend port, default: 3001")
    app_run_parser.add_argument("--frontend-port", default="5173", help="Frontend port, default: 5173")
    app_run_parser.set_defaults(func=lambda args: app_command(args, "dev"))

    doctor_parser = registry.add(
        ("doctor",),
        subparsers.add_parser(
            "doctor",
            help="Check local toolchain and device visibility",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""examples:
  ./dev doctor
  ./dev doctor --ncs v2.9.2
  ./dev doctor --dry-run
""",
        ),
    )
    add_dry_run_option(doctor_parser)
    doctor_parser.add_argument("--ncs", default=DEFAULT_NCS, help=f"NCS version, default: {DEFAULT_NCS}")
    doctor_parser.set_defaults(func=doctor)

    help_parser = registry.add(
        ("help",),
        subparsers.add_parser(
            "help",
            help="Show help for ./dev or a command topic",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""examples:
  ./dev help
  ./dev help mote
  ./dev help mote build
  ./dev help gateway
""",
        ),
    )
    help_parser.add_argument("topic", nargs="*", help="Optional command topic, for example: mote build")
    help_parser.set_defaults(func=lambda args: show_help(args, registry))

    return parser, registry


def normalize_global_options(argv: list[str]) -> tuple[list[str], bool]:
    cleaned: list[str] = []
    dry_run = False
    for arg in argv:
        if arg == "--dry-run":
            dry_run = True
        else:
            cleaned.append(arg)
    return cleaned, dry_run


def show_help(args: argparse.Namespace, registry: ParserRegistry) -> None:
    topic = list(args.topic)
    parser = registry.get(topic)
    if parser is None:
        requested = " ".join(topic)
        valid = sorted(" ".join(key) or "root" for key in registry.parsers)
        raise SystemExit(f"Unknown help topic: {requested}\nValid topics: {', '.join(valid)}")
    parser.print_help()


def print_root_command_error(parser: argparse.ArgumentParser, command: str | None) -> None:
    if command:
        print(f"Unknown command: {command}", file=sys.stderr)
    else:
        print("Missing command.", file=sys.stderr)
    print(f"Valid commands: {', '.join(ROOT_COMMANDS)}", file=sys.stderr)
    print("Run './dev help' for examples.", file=sys.stderr)


def main(argv: list[str] | None = None) -> int:
    parser, registry = build_parser()
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    normalized_argv, dry_run = normalize_global_options(raw_argv)

    if not normalized_argv:
        parser.print_help(sys.stderr)
        print_root_command_error(parser, None)
        return 2
    if normalized_argv[0] not in ROOT_COMMANDS and normalized_argv[0] not in ("-h", "--help"):
        print_root_command_error(parser, normalized_argv[0])
        return 2
    if normalized_argv[0] in COMMAND_GROUPS and len(normalized_argv) == 1:
        group_parser = registry.get([normalized_argv[0]])
        assert group_parser is not None
        group_parser.print_help()
        return 2

    args = parser.parse_args(normalized_argv)
    args.dry_run = dry_run or getattr(args, "dry_run", False)
    try:
        args.func(args)
    except subprocess.CalledProcessError as exc:
        return exc.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
