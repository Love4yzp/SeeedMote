#!/usr/bin/env python3
"""Human-friendly development entrypoint for SeeedMote v2."""

from __future__ import annotations

import argparse
import glob
import os
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path


ROOT = Path(__file__).resolve().parent
MOTE_DIR = ROOT / "mote"
GATEWAY_YAML = ROOT / "gateway" / "esphome.yaml"
DEFAULT_NCS = "v2.9.2"
DEFAULT_BOARD = "xiao_ble/nrf52840/sense"
DEFAULT_BUILD_DIR = "build_uf2"
DEFAULT_VOLUME = "/Volumes/XIAO-SENSE"
DEFAULT_PORT_GLOB = "/dev/cu.usbmodem*"


def rel(path: Path | str) -> str:
    path = Path(path)
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


def shell_line(command: list[str], env: dict[str, str] | None = None) -> str:
    prefix = ""
    if env:
        prefix = " ".join(f"{key}={shlex.quote(value)}" for key, value in env.items()) + " "
    return prefix + shlex.join(command)


def run_command(
    command: list[str],
    *,
    cwd: Path = ROOT,
    env: dict[str, str] | None = None,
    dry_run: bool = False,
) -> None:
    if dry_run:
        print(f"cwd: {rel(cwd)}")
        print(f"$ {shell_line(command, env)}")
        return

    merged_env = os.environ.copy()
    if env:
        merged_env.update(env)
    subprocess.run(command, cwd=cwd, env=merged_env, check=True)


def ncs_env(ncs_version: str) -> dict[str, str]:
    return {"ZEPHYR_BASE": str(Path.home() / "ncs" / ncs_version / "zephyr")}


def west_command(ncs_version: str, west_args: list[str]) -> list[str]:
    return [
        "nrfutil",
        "toolchain-manager",
        "launch",
        "--ncs-version",
        ncs_version,
        "--",
        "west",
        *west_args,
    ]


def mote_build(args: argparse.Namespace) -> None:
    if getattr(args, "clean", False):
        mote_clean(args)

    command = west_command(
        args.ncs,
        [
            "build",
            "--no-sysbuild",
            "-p",
            "always",
            "-b",
            args.board,
            "-d",
            args.build_dir,
        ],
    )
    if args.debug:
        command.extend(["--", "-DEXTRA_CONF_FILE=debug.conf"])

    run_command(command, cwd=MOTE_DIR, env=ncs_env(args.ncs), dry_run=args.dry_run)


def mote_clean(args: argparse.Namespace) -> None:
    command = west_command(args.ncs, ["build", "-d", args.build_dir, "-t", "pristine"])
    run_command(command, cwd=MOTE_DIR, env=ncs_env(args.ncs), dry_run=args.dry_run)


def expanded_ports(port: str | None) -> list[str]:
    if port:
        return [port]
    return sorted(glob.glob(DEFAULT_PORT_GLOB))


def touch_1200_baud(ports: list[str]) -> None:
    if not ports:
        return
    try:
        import serial  # type: ignore
    except ImportError:
        print("pyserial is not installed; skipping 1200-baud bootloader touch.")
        return

    for port in ports:
        try:
            print(f"1200-baud touch -> {port}")
            handle = serial.Serial(port, 1200)
            time.sleep(0.05)
            handle.close()
        except Exception:
            pass


def wait_for_volume(volume: str, seconds: float) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if Path(volume).is_dir():
            return True
        time.sleep(0.3)
    return Path(volume).is_dir()


def mote_flash(args: argparse.Namespace) -> None:
    mote_build(args)

    uf2 = MOTE_DIR / args.build_dir / "zephyr" / "zephyr.uf2"
    ports = expanded_ports(args.port)

    if args.dry_run:
        for port in ports or [DEFAULT_PORT_GLOB]:
            print(f"1200-baud touch -> {port}")
        print(f"wait for volume: {args.volume}")
        run_command(["cp", "-X", str(uf2), f"{args.volume}/"], dry_run=True)
        return

    touch_1200_baud(ports)
    print(f"Waiting for {args.volume} (up to 3s, auto via 1200-baud touch)...")
    mounted = wait_for_volume(args.volume, 3)
    if not mounted:
        print()
        print("XIAO bootloader volume was not found.")
        print("Double-tap RESET on the XIAO nRF52840 Sense now.")
        print(f"Waiting for {args.volume} (up to 30s)...")
        mounted = wait_for_volume(args.volume, 30)

    if not mounted:
        raise SystemExit(f"{args.volume} still not mounted; flash aborted.")
    if not uf2.exists():
        raise SystemExit(f"UF2 not found: {uf2}")

    run_command(["cp", "-X", str(uf2), f"{args.volume}/"])


def resolve_log_port(port: str | None) -> str:
    ports = expanded_ports(port)
    if not ports:
        raise SystemExit(f"No serial port matched {DEFAULT_PORT_GLOB}; pass --port /dev/cu.*")
    if len(ports) > 1 and port is None:
        print(f"Multiple ports found; using {ports[0]}. Pass --port to choose explicitly.")
    return ports[0]


def mote_log(args: argparse.Namespace) -> None:
    port = args.port or DEFAULT_PORT_GLOB
    if not args.dry_run:
        port = resolve_log_port(args.port)
    run_command(["tio", port], dry_run=args.dry_run)


def mote_run(args: argparse.Namespace) -> None:
    mote_flash(args)
    mote_log(args)


def gateway_command(args: argparse.Namespace, action: str) -> None:
    command = ["esphome", action, rel(GATEWAY_YAML)]
    run_command(command, dry_run=args.dry_run)


def app_command(args: argparse.Namespace, target: str) -> None:
    command = ["make", "-C", "app", target]
    if target == "dev":
        command.append(f"MOCK={'true' if args.mock else 'false'}")
    run_command(command, dry_run=args.dry_run)


def doctor(args: argparse.Namespace) -> None:
    if args.dry_run:
        print("doctor checks skipped in --dry-run")
        return

    checks = [
        ("nrfutil", shutil.which("nrfutil") is not None),
        ("tio", shutil.which("tio") is not None),
        ("esphome", shutil.which("esphome") is not None),
        ("gateway/secrets.yaml", (ROOT / "gateway" / "secrets.yaml").exists()),
        (f"~/ncs/{args.ncs}/zephyr", (Path.home() / "ncs" / args.ncs / "zephyr").exists()),
        (DEFAULT_VOLUME, Path(DEFAULT_VOLUME).is_dir()),
    ]

    for name, ok in checks:
        print(f"{'ok' if ok else 'missing'}  {name}")

    ports = sorted(glob.glob("/dev/cu.*"))
    if ports:
        print("serial ports:")
        for port in ports:
            print(f"  {port}")
    else:
        print("serial ports: none")


def add_mote_options(parser: argparse.ArgumentParser, *, include_debug: bool = False) -> None:
    parser.add_argument("--ncs", default=DEFAULT_NCS, help=f"NCS version, default: {DEFAULT_NCS}")
    parser.add_argument("--board", default=DEFAULT_BOARD, help=f"Zephyr board, default: {DEFAULT_BOARD}")
    parser.add_argument("--build-dir", default=DEFAULT_BUILD_DIR, help=f"Build directory, default: {DEFAULT_BUILD_DIR}")
    if include_debug:
        parser.add_argument("--debug", action="store_true", help="Build with mote/debug.conf USB CDC console")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="./dev", description="SeeedMote v2 development CLI")
    parser.add_argument("--dry-run", action="store_true", help="Print commands without running them")

    subparsers = parser.add_subparsers(dest="area", required=True)

    mote = subparsers.add_parser("mote", help="nRF52840 mote firmware")
    mote_sub = mote.add_subparsers(dest="action", required=True)

    mote_build_parser = mote_sub.add_parser("build", help="Build mote UF2 firmware")
    add_mote_options(mote_build_parser, include_debug=True)
    mote_build_parser.add_argument("--clean", action="store_true", help="Pristine before building")
    mote_build_parser.set_defaults(func=mote_build)

    mote_flash_parser = mote_sub.add_parser("flash", help="Build and copy UF2 to the XIAO bootloader volume")
    add_mote_options(mote_flash_parser, include_debug=True)
    mote_flash_parser.add_argument("--volume", default=DEFAULT_VOLUME, help=f"UF2 volume, default: {DEFAULT_VOLUME}")
    mote_flash_parser.add_argument("--port", help="Serial port used for 1200-baud bootloader touch")
    mote_flash_parser.set_defaults(func=mote_flash)

    for name in ("log", "monitor"):
        mote_log_parser = mote_sub.add_parser(name, help="Open mote serial logs")
        mote_log_parser.add_argument("--port", help=f"Serial port, default: {DEFAULT_PORT_GLOB}")
        mote_log_parser.set_defaults(func=mote_log)

    mote_run_parser = mote_sub.add_parser("run", help="Flash mote firmware, then open logs")
    add_mote_options(mote_run_parser, include_debug=True)
    mote_run_parser.add_argument("--volume", default=DEFAULT_VOLUME, help=f"UF2 volume, default: {DEFAULT_VOLUME}")
    mote_run_parser.add_argument("--port", help="Serial port")
    mote_run_parser.set_defaults(func=mote_run)

    mote_clean_parser = mote_sub.add_parser("clean", help="Pristine mote build directory")
    add_mote_options(mote_clean_parser)
    mote_clean_parser.set_defaults(func=mote_clean)

    gateway = subparsers.add_parser("gateway", help="ESPHome gateway")
    gateway_sub = gateway.add_subparsers(dest="action", required=True)
    for name, action, help_text in (
        ("compile", "compile", "Compile gateway ESPHome config"),
        ("run", "run", "Compile, flash, and stream gateway logs"),
        ("log", "logs", "Stream gateway logs"),
        ("logs", "logs", "Stream gateway logs"),
    ):
        gateway_parser = gateway_sub.add_parser(name, help=help_text)
        gateway_parser.set_defaults(func=lambda args, esphome_action=action: gateway_command(args, esphome_action))

    app = subparsers.add_parser("app", help="Retail demo app")
    app_sub = app.add_subparsers(dest="action", required=True)
    app_run_parser = app_sub.add_parser("run", help="Start backend and frontend")
    app_run_parser.add_argument("--mock", action="store_true", help="Use scripted mock events")
    app_run_parser.set_defaults(func=lambda args: app_command(args, "dev"))
    app_install_parser = app_sub.add_parser("install", help="Install app Python and npm dependencies")
    app_install_parser.set_defaults(func=lambda args: app_command(args, "install"))

    doctor_parser = subparsers.add_parser("doctor", help="Check local toolchain and device visibility")
    doctor_parser.add_argument("--ncs", default=DEFAULT_NCS, help=f"NCS version, default: {DEFAULT_NCS}")
    doctor_parser.set_defaults(func=doctor)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        args.func(args)
    except subprocess.CalledProcessError as exc:
        return exc.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
