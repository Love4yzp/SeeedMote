# ESPHome test defaults are tracked in gateway/secrets.yaml.
# Do not put real production credentials there.

# PlatformIO (historical, no longer used)
.pio/
.pioenvs/
.piolibdeps/
.vscode/
.cache/

# Build artifacts
build/
build_uf2/
*.elf
*.bin
*.hex
*.uf2
*.map

# ESP-IDF
sdkconfig
sdkconfig.old
sdkconfig.*
!sdkconfig.defaults
managed_components/
dependencies.lock

# Zephyr / west — only inside mote projects (workspace state, NCS sources)
.west/
**/build/
**/build_uf2/
nrf/
nrfxlib/
modules/
bootloader/
test/
tools/
zephyr/
zephyr-sources/

# IDE / OS
.idea/
.DS_Store
*.swp
*~

# Local AI tooling (per-machine permissions, etc.) — ignore contents,
# but check in .claude/skills/ so all agents share the same entry points.
.claude/*
!.claude/skills/

# Python / tooling
__pycache__/
*.pyc
.venv/
.envrc

# Node / web tooling
node_modules/
dist/

# Playwright MCP tooling
.playwright-mcp/

# Screenshots / generated images
*.png
*.jpg
*.jpeg
