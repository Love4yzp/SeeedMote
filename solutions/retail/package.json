{
  "name": "seeedmote-retail",
  "private": true,
  "workspaces": ["server", "app"],
  "scripts": {
    "dev": "concurrently \"node --import tsx/esm server/src/index.ts --mock\" \"npm run dev --workspace=app\"",
    "dev:live": "concurrently \"node --import tsx/esm server/src/index.ts\" \"npm run dev --workspace=app\"",
    "build": "npm run build --workspace=server && npm run build --workspace=app",
    "start": "node --import tsx/esm server/src/index.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0"
  }
}
