# Pin the app version explicitly so ESP-IDF skips git_describe at configure
# (PIO ships ESP-IDF as a flat tarball, so git lookups inside its components
# fail and abort configure with a confusing error).
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.0"

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
# XIAO ESP32-S3 has no USB-UART bridge IC; the USB connector goes straight
# to the chip's native USB-Serial-JTAG peripheral. Route console there so
# `pio device monitor` actually sees app log on /dev/cu.usbmodem*.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# XIAO ESP32-S3 ships with 8 MB flash; ESP-IDF default is 2 MB which truncates
# the partition table at the bootloader stage. Pin explicitly.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Use the larger single-app partition (~1.5 MB) since WiFi + NimBLE + lwIP
# baseline alone is ~900 KB and the default 1 MB partition would sit at 90%.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# BLE: NimBLE host, OBSERVER role only (scan + decode BTHome service data).
# First version is uplink-only; gateway does not connect to motes.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
# BROADCASTER must stay y: ESP-IDF 5.2.2 NimBLE has an unguarded call to
# ble_gap_adv_active_instance() in ble_gap.c (host shutdown path) that
# only links when NIMBLE_BLE_ADVERTISE || NIMBLE_BLE_CONNECT is true.
# We never call adv APIs, so the role flag costs only a few KB of code.
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# OBSERVER defaults to y; left implicit.

# WiFi: STA mode — connects to user network; MQTT carries data and control.
CONFIG_ESP_WIFI_ENABLED=y

# BLE + WiFi software coexistence (shared radio on ESP32-S3).
# Without this, WiFi TX bursts silently drop BLE scan windows.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
